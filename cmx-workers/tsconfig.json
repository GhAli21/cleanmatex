{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["../web-admin/*"],
      "@lib/*": ["../web-admin/lib/*"],
      "server-only": ["./src/stubs/server-only.ts"]
    }
  },
  "include": ["src", "test"]
}
